routes:
  copy@mill.example.com: copy_rename
  uppercase@mill.example.com: uppercase
  report@mill.example.com: pdf_report
# How the reply for each address is delivered. Absent means "email": the output
# file is attached, which is what copy@ and uppercase@ do.
#
#   sheets-link  upload the output to Google Drive, convert it to a Google
#                Sheet shared with anyone who has the link, and reply with the
#                link instead of a file.
#
# A sheets-link address should be routed to an operation whose layout is
# "sheets" (see config/transformers.yaml) — Drive will convert an excel-layout
# workbook too, it just looks worse. A mismatch logs one warning at startup.
# An operation that declares no layout at all — one output shape, no options —
# is not a mismatch and is not flagged.
#
# sheets-link requires GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, and
# GOOGLE_OAUTH_REFRESH_TOKEN in the environment; the worker refuses to start
# without them rather than quietly falling back to attaching the file.
delivery:
  report@mill.example.com: sheets-link

allowed_senders: []
max_attachment_bytes: 20971520
# Timeout for an outbound Mailgun send (reply). Bounds a hung connection so it
# can't stall the delivery loop. Defaults to 30 if unset or <= 0.
send_timeout_seconds: 30

# Operator alerts. Systemic failures (a crashed or timed-out transformer, replies
# failing for 5 minutes, intake errors, retention sweeps that can't delete) are
# emailed to this address, from REPLY_FROM. Empty or absent turns them off.
#
# Alerts are throttled: one per category every alert_cooldown_minutes (the next
# email counts the ones held back), and at most alert_max_per_hour and
# alert_max_per_day across every category. The daily cap is sized for the
# Mailgun Free plan, whose 100 sends a day are shared with replies; raise it
# only on a paid plan. The values shown are the defaults.
alert_recipient: ""   # e.g. support@example.com
# alert_cooldown_minutes: 15
# alert_max_per_hour: 10
# alert_max_per_day: 20
